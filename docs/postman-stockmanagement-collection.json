{
  "info": {
    "_postman_id": "stockmanagement-ki-tdd",
    "name": "StockManagement KI - TDD API Tests",
    "description": "Data-driven Postman tests for the current NestJS StockManagement KI API.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "function expectJsonResponse() {",
          "  pm.test('response is JSON', function () {",
          "    pm.response.to.have.header('Content-Type');",
          "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
          "  });",
          "",
          "  const json = pm.response.json();",
          "  pm.test('uses standard API envelope', function () {",
          "    pm.expect(json).to.have.property('success');",
          "    pm.expect(json).to.have.property('statusCode');",
          "    pm.expect(json).to.have.property('timestamp');",
          "  });",
          "  return json;",
          "}",
          "",
          "if (pm.response.code !== 204 && pm.response.headers.get('Content-Type')) {",
          "  expectJsonResponse();",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login stores token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('login succeeds', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "pm.test('login returns token and user', function () {",
                  "  pm.expect(json.success).to.eql(true);",
                  "  pm.expect(json.data).to.have.property('accessToken');",
                  "  pm.expect(json.data).to.have.property('user');",
                  "});",
                  "",
                  "pm.environment.set('token', json.data.accessToken);"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            }
          }
        },
        {
          "name": "Login rejects invalid credentials",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('invalid login is unauthorized', function () {",
                  "  pm.response.to.have.status(401);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "pm.test('error envelope is returned', function () {",
                  "  pm.expect(json.success).to.eql(false);",
                  "  pm.expect(json.statusCode).to.eql(401);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"wrong-password\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Health",
      "item": [
        {
          "name": "GET /",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('root responds', function () {",
                  "  pm.expect(pm.response.code).to.be.oneOf([200, 401]);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                ""
              ]
            }
          }
        }
      ]
    },
    {
      "name": "CRUD Resources",
      "description": "Run this folder with docs/postman-crud-data.json. Each iteration tests create, list, get by id, patch, and delete for one resource.",
      "item": [
        {
          "name": "Create {{resourceName}}",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('create returns success', function () {",
                  "  pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "pm.test('created entity has id', function () {",
                  "  pm.expect(json.success).to.eql(true);",
                  "  pm.expect(json.data).to.have.property('id');",
                  "});",
                  "",
                  "pm.environment.set('currentEntityId', json.data.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{{createBody}}"
            },
            "url": {
              "raw": "{{baseUrl}}{{resourcePath}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "{{resourcePath}}"
              ]
            }
          }
        },
        {
          "name": "List {{resourceName}}",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('list returns success', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "pm.test('list data is array', function () {",
                  "  pm.expect(json.success).to.eql(true);",
                  "  pm.expect(json.data).to.be.an('array');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}{{resourcePath}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "{{resourcePath}}"
              ]
            }
          }
        },
        {
          "name": "Get {{resourceName}} by id",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('get by id returns success', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "pm.test('returned entity matches created id', function () {",
                  "  pm.expect(json.success).to.eql(true);",
                  "  pm.expect(String(json.data.id)).to.eql(String(pm.environment.get('currentEntityId')));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}{{resourcePath}}/{{currentEntityId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "{{resourcePath}}",
                "{{currentEntityId}}"
              ]
            }
          }
        },
        {
          "name": "Update {{resourceName}}",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('update returns success', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "pm.test('updated entity matches id', function () {",
                  "  pm.expect(json.success).to.eql(true);",
                  "  pm.expect(String(json.data.id)).to.eql(String(pm.environment.get('currentEntityId')));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{{updateBody}}"
            },
            "url": {
              "raw": "{{baseUrl}}{{resourcePath}}/{{currentEntityId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "{{resourcePath}}",
                "{{currentEntityId}}"
              ]
            }
          }
        },
        {
          "name": "Delete {{resourceName}}",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('delete returns no content', function () {",
                  "  pm.response.to.have.status(204);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}{{resourcePath}}/{{currentEntityId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "{{resourcePath}}",
                "{{currentEntityId}}"
              ]
            }
          }
        }
      ]
    },
